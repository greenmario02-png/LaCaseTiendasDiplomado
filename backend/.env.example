DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/NOMBRE_BD"
JWT_SECRET="cambiar-por-secreto-seguro-de-al-menos-32-caracteres"
JWT_REFRESH_SECRET="cambiar-por-secreto-refresh-seguro-de-al-menos-32"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# URL pública de este backend (sin barra final). El seed la usa para armar las URLs de las
# imágenes locales de prisma/seed-assets/. En producción: la URL de Render.
BACKEND_URL="http://localhost:3000"

# Cotización USD/BOB (Binance P2P): intervalo aleatorio de refresco en minutos
CURRENCY_REFRESH_MIN_MINUTES=8
CURRENCY_REFRESH_MAX_MINUTES=14

# Almacenamiento de imágenes subidas (avatar, tienda, productos, foro). Si se dejan vacías,
# las imágenes se guardan en disco local (backend/uploads) — solo válido para desarrollo.
# En producción, completar con el proyecto de Supabase (Storage > bucket público
# "lacase-uploads" > Settings > Project API keys > service_role).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="lacase-uploads"
