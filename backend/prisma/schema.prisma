generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SELLER
  CUSTOMER
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

enum PaymentStatus {
  PENDING
  PROOF_SUBMITTED
  VERIFIED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum AttributeType {
  TEXT
  NUMBER
  SELECT
  BOOLEAN
}

enum SlotType {
  CPU
  MOTHERBOARD
  RAM
  GPU
  STORAGE
  PSU
  CASE
  COOLER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DeliveryType {
  PRESENCIAL
  DELIVERY
  ENVIO
  RETIRO
  PERMUTA
}

model User {
  jobApplications      JobApplication[] @relation("JobApplications")
  jobPostingsStore     JobPosting[] @relation("JobPostingsStore")
  jobPostingsCreated   JobPosting[] @relation("JobPostingsCreated")
  jobPostingsReviewed  JobPosting[] @relation("JobPostingsReviewed")
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  passwordHash       String
firstName          String
lastName           String
phone              String?
profileImage       String?
bio                String?
role               Role      @default(CUSTOMER)
storeName          String?
storeDescription   String?
storeLogo          String?
storeBanner        String?
storeCategory      String?
country            String?
locationCity       String?
locationState      String?
locationPostalCode String?
latitude           Float?
longitude          Float?
locationVerified   Boolean   @default(false)
paymentQrUrl       String?
youtubeUrl         String?
tiktokUrl          String?
instagramUrl       String?
facebookUrl        String?
whatsappPhone      String?
  rating             Float     @default(0)
  totalSales         Int       @default(0)
  freeShippingThreshold Decimal? @db.Decimal(12, 2)
  isVerified         Boolean   @default(false)
  nit                String?
  isVerificationRequested Boolean @default(false)
  verificationNote   String?
  isApproved         Boolean   @default(false)
  isActive           Boolean   @default(true)
  storePaused        Boolean   @default(false)
  storeRole          String?   @default("OWNER")
  storeOwnerId       Int?
  storeOwner         User?     @relation("StoreEmployees", fields: [storeOwnerId], references: [id], onDelete: SetNull)
  storeEmployees     User[]    @relation("StoreEmployees")
  gamerCoins         Int       @default(0)
  pushToken          String?
  inviteCode         String?   @unique
  referredById       Int?
  referredBy         User?     @relation("ReferredUsers", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers      User[]    @relation("ReferredUsers")
  coinTransactions   CoinTransaction[]
  forumProfile       ForumProfile?
  userRoles          UserRole[]
  strikes            UserStrike[]        @relation("UserStrikeSubject")
  strikesIssued      UserStrike[]        @relation("StrikeIssuer")
  contentEvidence    ContentEvidence[]
  takedownsResolved  TakedownRequest[]   @relation("TakedownResolver")
  blacklistEntriesAdded BlacklistEntry[] @relation("BlacklistAdder")
  botAccount         BotAccount?
  botAccountsOperated BotAccount[]       @relation("BotOperator")
  botConversations   BotConversation[]
  debateZoneAlias    DebateZoneAlias?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  products         Product[]
  giftPromotions   GiftPromotion[]  @relation("GiftPromotions")
  cart             Cart?
  ordersBought     Order[]   @relation("OrdersBought")
  ordersSold       Order[]   @relation("OrdersSold")
  addresses        Address[]
  builds           Build[]
  wishlistItems    WishlistItem[]
  reviewsWritten   Review[]  @relation("ProductReviews")
  sellerReviews    Review[]  @relation("SellerReviews")
  sellerTagVotesGiven   ReviewTagVote[] @relation("UserTagVotes")
  sellerTagVotesReceived ReviewTagVote[] @relation("SellerTagVotes")
  refreshTokens    RefreshToken[]
  conversationsAsBuyer  Conversation[] @relation("ConversationBuyer")
  conversationsAsSeller Conversation[] @relation("ConversationSeller")
  messagesSent          Message[]      @relation("MessageSender")
  auctionsCreated       Auction[]      @relation("AuctionSeller")
  auctionsWon           Auction[]      @relation("AuctionWinner")
  auctionBids           AuctionBid[]   @relation("Bidder")
  proxyBids             AuctionProxyBid[] @relation("ProxyBidder")
  auctionWatchlist      AuctionWatchlist[] @relation("AuctionWatcher")
  notifications         Notification[]
  returnsAsBuyer        ReturnRequest[]  @relation("ReturnBuyer")
  returnsAsSeller       ReturnRequest[]  @relation("ReturnSeller")
  affiliateAccount      Affiliate?
  affiliateReferrals    AffiliateReferral[] @relation("AffiliateReferred")
  productAudits         ProductAudit[]
  privilegedBuyers      PrivilegedBuyer[] @relation("PrivilegedSellers")
  privilegedAtSellers   PrivilegedBuyer[] @relation("PrivilegedBuyers")
  couponsCreated        Coupon[]          @relation("CouponSeller")
  couponUsages          CouponUsage[]
  sellerPromotions      Promotion[]       @relation("SellerPromotions")
  payoutAccount         PayoutAccount?
  payouts               Payout[]
  knownProducts         KnownProduct[]

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  parentId  Int?
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  icon      String?
  imageUrl  String?
  order     Int       @default(0)
  isActive  Boolean   @default(true)

  products           Product[]
  attributeDefs      AttributeDefinition[]
  knownProducts      KnownProduct[]
  auctions           Auction[]
  taxRates           TaxRate[]

  @@map("categories")
}

model KnownProduct {
  id         Int                   @id @default(autoincrement())
  categoryId Int
  category   Category              @relation(fields: [categoryId], references: [id])
  sellerId   Int?
  seller     User?                 @relation(fields: [sellerId], references: [id])
  name       String
  isActive   Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  attributes KnownProductAttribute[]

  @@index([categoryId])
  @@index([sellerId])
  @@map("known_products")
}

model KnownProductAttribute {
  id                   Int                 @id @default(autoincrement())
  knownProductId       Int
  knownProduct         KnownProduct        @relation(fields: [knownProductId], references: [id], onDelete: Cascade)
  attributeDefinitionId Int
  attributeDefinition  AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id])
  defaultValue         String?
  isRequired           Boolean             @default(false)

  @@unique([knownProductId, attributeDefinitionId])
  @@map("known_product_attributes")
}

model AttributeDefinition {
  id           Int           @id @default(autoincrement())
  name         String
  type         AttributeType @default(TEXT)
  categoryId   Int?
  category     Category?     @relation(fields: [categoryId], references: [id])
  options      Json?
  unit         String?
  isRequired   Boolean       @default(false)
  isFilterable Boolean       @default(true)
  isVariant    Boolean       @default(false)
  isActive     Boolean       @default(true)
  order        Int           @default(0)

  productAttributes ProductAttribute[]
  knownProductAttrs KnownProductAttribute[]

  @@map("attribute_definitions")
}

model Product {
  id             Int              @id @default(autoincrement())
  sellerId       Int
  seller         User             @relation(fields: [sellerId], references: [id])
  categoryId     Int
  category       Category         @relation(fields: [categoryId], references: [id])
  name           String
  slug           String           @unique
  description    String?
  brand          String?
  condition      ProductCondition @default(NEW)
  conditionScore Int?
  deliveryTypes  DeliveryType[]
  acceptsTrade   Boolean          @default(false)
  price          Decimal          @db.Decimal(12, 2)
  originalPrice  Decimal?         @db.Decimal(12, 2)
  stock          Int              @default(0)
  sku            String           @unique
  masterSku      String?
  taxRateId      Int?
  taxRate        TaxRate?         @relation(fields: [taxRateId], references: [id])
  warrantyInfo   String?
  isActive       Boolean          @default(true)
  isApproved     Boolean          @default(false)
  isFeatured     Boolean          @default(false)
  viewCount      Int              @default(0)
  saleCount      Int              @default(0)
  rating         Float            @default(0)
  reactivationCount Int           @default(0)
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([masterSku])

  images             ProductImage[]
  attributes         ProductAttribute[]
  variants           ProductVariant[]
  tags               ProductTag[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  reviews            Review[]
  wishlistItems      WishlistItem[]
  buildComponents    BuildComponent[]
  promotionProducts  PromotionProduct[]
  couponProducts     CouponProduct[]
  giftTriggerPromotions GiftPromotion[] @relation("GiftTriggerProduct")
  giftItems             GiftPromotionItem[]
  conversations      Conversation[]
  views              ProductView[]
  auction            Auction?
  audits             ProductAudit[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([isApproved])
  @@index([name])
  @@map("products")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([productId])
  @@map("product_images")
}

model ProductAttribute {
  id                    Int                 @id @default(autoincrement())
  productId             Int
  product               Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeDefinitionId Int
  attributeDefinition   AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id])
  valueText             String?
  valueNumber           Float?
  valueBoolean          Boolean?

  @@unique([productId, attributeDefinitionId])
  @@map("product_attributes")
}

model ProductVariant {
  id             Int    @id @default(autoincrement())
  productId      Int
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String @unique
  priceModifier  Decimal @default(0) @db.Decimal(12, 2)
  stock          Int    @default(0)
  attributesJson Json?
  cartItems      CartItem[]

  @@index([productId])
  @@map("product_variants")
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String
  slug  String @unique
  group String?
  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     Int
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int?     @unique
  user      User?    @relation(fields: [userId], references: [id])
  sessionId String?  @unique
  items     CartItem[]
  createdAt DateTime @default(now())

  @@map("carts")
}

model CartItem {
  id        Int            @id @default(autoincrement())
  cartId    Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product        @relation(fields: [productId], references: [id])
  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int            @default(1)

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

model Address {
  id         Int     @id @default(autoincrement())
  userId     Int
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  street     String
  number     String
  floor      String?
  city       String
  state      String
  postalCode String
  isDefault  Boolean @default(false)
  orders     Order[]

  @@index([userId])
  @@map("addresses")
}

model Order {
  id                Int           @id @default(autoincrement())
  buyerId           Int
  buyer             User          @relation("OrdersBought", fields: [buyerId], references: [id])
  sellerId          Int
  seller            User          @relation("OrdersSold", fields: [sellerId], references: [id])
  status            OrderStatus   @default(PENDING)
  subtotal          Decimal       @db.Decimal(12, 2)
  shippingCost      Decimal?      @db.Decimal(12, 2)
  total             Decimal       @db.Decimal(12, 2)
  discountAmount    Decimal?      @db.Decimal(12, 2)
  couponId          Int?
  coupon            Coupon?       @relation(fields: [couponId], references: [id])
  commission        Decimal?      @db.Decimal(12, 2)
  sellerNet         Decimal?      @db.Decimal(12, 2)
  paymentMethod     String?
  paymentStatus     PaymentStatus @default(PENDING)
  paymentQrUrl      String?
  paymentProofUrl   String?
  shippingAddressId Int?
  shippingAddress   Address?      @relation(fields: [shippingAddressId], references: [id])
  fulfillmentType   String        @default("SHIPPING") // SHIPPING | PICKUP
  pickupAddress     String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deliveredAt       DateTime?

  items  OrderItem[]
  returns ReturnRequest[]
  affiliateReferrals AffiliateReferral[]
  auctionWon     Auction?    @relation("AuctionOrder")
  reviews        Review[]    @relation("OrderReviews")

  @@index([buyerId])
  @@index([sellerId])
  @@map("orders")
}

model Coupon {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  description  String?
  type         String    @default("PERCENTAGE") // PERCENTAGE | FIXED | GIFT
  value        Decimal   @db.Decimal(12, 2)
  sellerId     Int?
  seller       User?     @relation("CouponSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  minSpend     Decimal?  @db.Decimal(12, 2)
  maxUses      Int?      @default(1)
  usesCount    Int       @default(0)
  spentAmount  Decimal?  @db.Decimal(12, 2)
  maxSpend     Decimal?  @db.Decimal(12, 2)
  perUserLimit Int?
  isSingleUse  Boolean   @default(false)
  startDate    DateTime?
  endDate      DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  orders       Order[]
  products     CouponProduct[]
  usages       CouponUsage[]

  @@index([sellerId])
  @@map("coupons")
}

model CouponUsage {
  id        Int      @id @default(autoincrement())
  couponId  Int
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   Int
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@unique([couponId, userId])
  @@map("coupon_usages")
}

model CouponProduct {
  couponId  Int
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@map("coupon_products")
}

model PayoutAccount {
  id          Int      @id @default(autoincrement())
  sellerId    Int      @unique
  seller      User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  method      String   @default("BNB") // BNB | BANK | QR
  accountHolder String?
  accountNumber String?
  bankName    String?
  phoneQr     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("payout_accounts")
}

model Payout {
  id          Int       @id @default(autoincrement())
  sellerId    Int
  seller      User      @relation(fields: [sellerId], references: [id])
  amount      Decimal   @db.Decimal(12, 2)
  status      String    @default("PENDING") // PENDING | APPROVED | PAID | REJECTED
  method      String    @default("BNB")
  reference   String?
  note        String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([sellerId])
  @@map("payouts")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  isGift    Boolean @default(false)
  giftLabel String?
  promotionId    Int?
  promotionTitle String?
  returns   ReturnRequest[]

  @@index([orderId])
  @@map("order_items")
}

model ReturnRequest {
  id             Int       @id @default(autoincrement())
  orderItemId    Int
  orderItem      OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderId        Int
  order          Order     @relation(fields: [orderId], references: [id])
  buyerId        Int
  buyer          User      @relation("ReturnBuyer", fields: [buyerId], references: [id])
  sellerId       Int
  seller         User      @relation("ReturnSeller", fields: [sellerId], references: [id])
  reason         String
  details        String?
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED | COMPLETED | CANCELLED
  refundAmount   Decimal?  @db.Decimal(12, 2)
  adminNote      String?
  responseNote   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([orderId])
  @@index([buyerId])
  @@index([sellerId])
  @@map("return_requests")
}

model Build {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  totalPrice Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  components BuildComponent[]

  @@index([userId])
  @@map("builds")
}

model BuildComponent {
  id        Int      @id @default(autoincrement())
  buildId   Int
  build     Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  slotType  SlotType

  @@index([buildId])
  @@map("build_components")
}

model WishlistItem {
  id        Int     @id @default(autoincrement())
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Promotion {
  id            Int          @id @default(autoincrement())
  title         String
  description   String?
  sellerId      Int?
  seller        User?        @relation("SellerPromotions", fields: [sellerId], references: [id], onDelete: Cascade)
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Decimal      @db.Decimal(12, 2)
  minQuantity   Int?
  minSpend      Decimal?     @db.Decimal(12, 2)
  maxSpend      Decimal?     @db.Decimal(12, 2)
  spentAmount   Decimal?     @db.Decimal(12, 2)
  usesCount     Int          @default(0)
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean      @default(true)
  products      PromotionProduct[]

  @@index([sellerId])
  @@map("promotions")
}

model PromotionProduct {
  promotionId Int
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@map("promotion_products")
}

model Banner {
  id             Int      @id @default(autoincrement())
  title          String?
  imageDesktop   String
  imageTablet    String?
  imageMobile    String?
  link           String?
  newWindow      Boolean  @default(false)
  backgroundColor String?
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  startDate      DateTime
  endDate        DateTime

  @@map("banners")
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId  Int?
  seller    User?    @relation("SellerReviews", fields: [sellerId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation("ProductReviews", fields: [userId], references: [id])
  orderId   Int?
  order     Order?   @relation("OrderReviews", fields: [orderId], references: [id], onDelete: SetNull)
  rating    Int
  comment   String?
  tags      Json?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([sellerId])
  @@index([orderId])
  @@map("reviews")
}

/// Votos por etiqueta de reseña sobre un vendedor (positiva/negativa).
/// Un usuario puede votar una sola vez por (vendedor, etiqueta).
model ReviewTagVote {
  id        Int      @id @default(autoincrement())
  sellerId  Int
  seller    User     @relation("SellerTagVotes", fields: [sellerId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation("UserTagVotes", fields: [userId], references: [id], onDelete: Cascade)
  tag       String // nombre exacto de la etiqueta (ej: "Recomendar", "No recomendar")
  createdAt DateTime @default(now())

  @@unique([sellerId, userId, tag])
  @@index([sellerId, tag])
  @@map("review_tag_votes")
}

model Faq {
  id       Int    @id @default(autoincrement())
  question String
  answer   String
  order    Int    @default(0)

  @@map("faqs")
}

model Warranty {
  id      Int    @id @default(autoincrement())
  title   String
  content String
  order   Int    @default(0)

  @@map("warranties")
}

model Reach {
  id      Int    @id @default(autoincrement())
  title   String
  content String
  order   Int    @default(0)

  @@map("reaches")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model SearchHistory {
  id        Int      @id @default(autoincrement())
  userId    Int?
  sessionId String?
  term      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("search_history")
}

model ProductView {
  id        Int      @id @default(autoincrement())
  userId    Int?
  sessionId String?
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([productId])
  @@index([createdAt])
  @@map("product_views")
}

model PrivilegedBuyer {
  id        Int       @id @default(autoincrement())
  sellerId  Int
  seller    User      @relation("PrivilegedSellers", fields: [sellerId], references: [id], onDelete: Cascade)
  buyerId   Int
  buyer     User      @relation("PrivilegedBuyers", fields: [buyerId], references: [id], onDelete: Cascade)
  status    String    @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime  @default(now())
  approvedAt DateTime?

  @@unique([sellerId, buyerId])
  @@map("privileged_buyers")
}

model Conversation {
  id           Int      @id @default(autoincrement())
  buyerId      Int
  buyer        User     @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId     Int
  seller       User     @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  productId    Int?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderId      Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  messages     Message[]

  @@unique([buyerId, sellerId, productId])
  @@index([sellerId])
  @@index([updatedAt])
  @@map("conversations")
}

enum NotificationType {
  JOB_APPLICATION_RECEIVED
  JOB_APPLICATION_UPDATED
  JOB_SUBMITTED
  JOB_APPROVED
  JOB_REJECTED
  NEW_ORDER
  ORDER_STATUS
  PAYMENT_VERIFIED
  PAYMENT_PROOF
  NEW_CHAT
  NEW_MESSAGE
  OUTBID
  AUCTION_WON
  AUCTION_SOLD
  AUCTION_ENDED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  SELLER_APPROVED
  SELLER_REJECTED
  NEW_REVIEW
  PROMOTION
  RETURN_REQUEST
  RETURN_STATUS
  SYSTEM
  FORUM_ANSWER
  FORUM_UPVOTE
  FORUM_BEST
  FORUM_RANK_UP
  FORUM_REPORT
  FORUM_COIN_EARN
}

model Notification {
  id          Int              @id @default(autoincrement())
  userId      Int
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  message     String
  /** Tipo de recurso al que apunta: order, chat, auction, product, seller, promotion */
  refType     String?
  refId       Int?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  content        String
  contentType    String       @default("text")
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model Auction {
  id            Int       @id @default(autoincrement())
  sellerId      Int
  seller        User      @relation("AuctionSeller", fields: [sellerId], references: [id])
  productId     Int?      @unique
  product       Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  categoryId    Int?
  category      Category? @relation(fields: [categoryId], references: [id])
  imageUrl      String?
  startingPrice Decimal   @db.Decimal(12, 2)
  currentPrice  Decimal   @db.Decimal(12, 2)
  reservePrice  Decimal?  @db.Decimal(12, 2)
  buyNowPrice   Decimal?  @db.Decimal(12, 2)
  minIncrement  Decimal   @default(1) @db.Decimal(12, 2)
  maxIncrement  Decimal   @default(10) @db.Decimal(12, 2)
  incrementType String    @default("fixed")
  extensionMinutes Int    @default(0)
  startDate     DateTime  @default(now())
  endDate       DateTime
  winnerId      Int?
  winner        User?     @relation("AuctionWinner", fields: [winnerId], references: [id])
  orderId       Int?      @unique
  order         Order?    @relation("AuctionOrder", fields: [orderId], references: [id])
  isSold        Boolean   @default(false)
  isActive      Boolean   @default(true)
  isPaid        Boolean   @default(false)
  paymentDeadline DateTime?
  createdAt     DateTime  @default(now())
  bids          AuctionBid[]
  proxyBids     AuctionProxyBid[]
  watchlist     AuctionWatchlist[]

  @@index([sellerId])
  @@index([endDate])
  @@index([categoryId])
  @@map("auctions")
}

model AuctionProxyBid {
  id        Int      @id @default(autoincrement())
  auctionId Int
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation("ProxyBidder", fields: [userId], references: [id])
  maxBid    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@unique([auctionId, userId])
  @@map("auction_proxy_bids")
}

model AuctionWatchlist {
  id        Int      @id @default(autoincrement())
  auctionId Int
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation("AuctionWatcher", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([auctionId, userId])
  @@map("auction_watchlist")
}

model AuctionBid {
  id        Int      @id @default(autoincrement())
  auctionId Int
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId  Int
  bidder    User     @relation("Bidder", fields: [bidderId], references: [id])
  bidAmount Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([auctionId])
  @@index([bidderId])
  @@map("auction_bids")
}

model ProductAudit {
  id         Int      @id @default(autoincrement())
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  actorId    Int
  actor      User     @relation(fields: [actorId], references: [id])
  action     String   // CREATED | UPDATED | MODERATED | ACTIVATED | DEACTIVATED | DELETED | REACTIVATED | AUCTIONED
  changes    Json?
  note       String?
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([actorId])
  @@map("product_audits")
}

model TaxRate {
  id            Int      @id @default(autoincrement())
  name          String
  country       String   // ISO 2 letras, ej "BO"
  state         String?  // Opcional: departamento/provincia específico
  ratePercent   Decimal  @db.Decimal(5, 2)
  appliesTo     String   @default("ALL") // ALL | CATEGORY | PRODUCT
  categoryId    Int?
  category      Category? @relation(fields: [categoryId], references: [id])
  products      Product[]
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([country])
  @@index([categoryId])
  @@map("tax_rates")
}

model Affiliate {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id])
  referralCode  String   @unique
  commissionPct Decimal  @db.Decimal(5, 2) @default(2.0)
  balance       Decimal  @db.Decimal(12, 2) @default(0)
  referrals     AffiliateReferral[]
  createdAt     DateTime @default(now())
}

model AffiliateReferral {
  id           Int      @id @default(autoincrement())
  affiliateId  Int
  affiliate    Affiliate @relation(fields: [affiliateId], references: [id])
  referredId   Int      @unique
  referred     User     @relation("AffiliateReferred", fields: [referredId], references: [id])
  orderId      Int?
  order        Order?   @relation(fields: [orderId], references: [id])
  commission   Decimal? @db.Decimal(12, 2)
  status       String   @default("REGISTERED") // REGISTERED | ORDER_PAID
  createdAt    DateTime @default(now())

  @@index([affiliateId])
  @@map("affiliate_referrals")
}

model GiftPromotion {
  id             Int                @id @default(autoincrement())
  sellerId       Int
  seller         User               @relation("GiftPromotions", fields: [sellerId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  triggerType    String             @default("UNITS") // UNITS | AMOUNT | PRODUCT
  triggerProductId Int?
  triggerProduct   Product?         @relation("GiftTriggerProduct", fields: [triggerProductId], references: [id], onDelete: SetNull)
  triggerQuantity Int?
  triggerAmount  Decimal?           @db.Decimal(12, 2)
  allowChoice    Boolean            @default(false)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  items          GiftPromotionItem[]

  @@index([sellerId])
  @@map("gift_promotions")
}

model GiftPromotionItem {
  id               Int        @id @default(autoincrement())
  giftPromotionId  Int
  giftPromotion    GiftPromotion @relation(fields: [giftPromotionId], references: [id], onDelete: Cascade)
  productId        Int
  product          Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([giftPromotionId, productId])
  @@map("gift_promotion_items")
}

model CoinTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int // positivo = gana/compra, negativo = gasta (canje)
  type      String // PURCHASE | EARN_PURCHASE | EARN_FORUM | SPEND
  refType   String? // ORDER | FORUM_QUESTION | FORUM_ANSWER | REWARD
  refId     Int?
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("coin_transactions")
}

// ─────────────────────────────────────────────────────────
// MÓDULO FORO (sección 8.6 — LaCASE Forum)
// ─────────────────────────────────────────────────────────

model ForumProfile {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Alias anónimo estilo Reddit
  forumUsername    String   @unique
  avatarUrl        String?  // puede diferir del avatar de la multitienda

  // Geolocalización de foro (independiente de User.locationCity)
  city             String   @default("Bolivia")
  cityVerified     Boolean  @default(false)  // true si se verificó con coords reales
  latitude         Float?   // última latitud reportada (GPS o ciudad seleccionada)
  longitude        Float?   // última longitud reportada
  radioKm          Int      @default(25)     // radio configurable por el usuario
  department       String?  // departamento deducido de la ciudad (moderación por departamento)
  lastGeoUpdate    DateTime? // última actualización de geolocalización
  cityId           Int?     // FK a ForumCity (ciudad del catálogo)
  cityRef          ForumCity? @relation(fields: [cityId], references: [id], onDelete: SetNull)

  // Karma y rangos
  karma            Int      @default(0)       // karma acumulado histórico (nunca baja)
  karmaSpent       Int      @default(0)       // karma canjeado (no afecta etiqueta)
  tag              String   @default("Novato") // Novato|Colaborador|Activo|Experto|Maestro|Leyenda
  reputationScore  Int      @default(0)       // suma de votos de reputación de otros usuarios

  // Gamificación
  streakDays       Int      @default(0)
  lastActiveDate   DateTime?
  signatureText    String?  // firma en el perfil (estilo foro clásico)
  signatureImage   String?  // URL imagen firma

  // Redes sociales del perfil del foro
  twitterUrl       String?
  linkedinUrl      String?
  whatsappPhone    String?
  websiteUrl       String?

  // Estado
  isBanned         Boolean  @default(false)
  bannedUntil      DateTime?
  bannedReason     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relaciones
  posts            ForumPost[]
  replies          ForumReply[]
  votes            ForumVote[]
  reputationGiven  ForumReputationComment[] @relation("ReputationGiver")
  reputationGot    ForumReputationComment[] @relation("ReputationReceiver")
  karmaTransactions KarmaTransaction[]
  reportsGiven     ForumReport[]            @relation("ReportAuthor")
  professionalVerifications ProfessionalVerification[]
  genericComments  GenericComment[]
  genericCommentVotes GenericCommentVote[]
  conoThemesCreated ConoTheme[] @relation("ConoThemeCreator")
  conoEntriesSubmitted ConoEntry[] @relation("ConoEntrySubmitter")
  conoVotes        ConoVote[]  @relation("ConoVoter")
  conoMatchVotes   ConoMatchVote[] @relation("ConoMatchVoter")

  @@map("forum_profiles")
  @@index([city])
  @@index([karma(sort: Desc)])
  @@index([department])
}

model ForumCategory {
  id          Int      @id @default(autoincrement())
  slug        String   @unique  // ej: "salud", "precio-producto"
  name        String
  description String?
  icon        String   @default("💬")  // emoji
  color       String   @default("#FF6B35") // hex
  parentId    Int?     // FK a sí mismo (máx. 2 niveles) — subforos profesionales usan esto:
                        // categoría padre = área (ej. "Informática"), hijas = Ciencia/Debates/Noticias/Preguntas
  parent      ForumCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    ForumCategory[] @relation("CategoryTree")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Subforo profesional: para publicar acá (o en cualquier hija) hace falta una
  // ProfessionalVerification aprobada en este campo. null = subforo abierto normal.
  requiresFieldId Int?
  requiresField   ProfessionalField? @relation(fields: [requiresFieldId], references: [id], onDelete: SetNull)

  // Subforo de universidad: visibilidad geolocalizada (ver University + assertUniversityAccess).
  universityId Int?
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  /// Zona de Debate: en esta categoría se muestra el alias
  /// de `DebateZoneAlias` en vez del `forumUsername` real. Publicar/ver acá NO requiere nada
  /// especial (a diferencia de requiresFieldId/universityId) — cualquiera puede participar.
  isDebateZone Boolean @default(false)

  posts       ForumPost[]
  cityCategories ForumCityCategory[]

  @@map("forum_categories")
  @@index([parentId])
  @@index([isActive, sortOrder])
  @@index([requiresFieldId])
  @@index([universityId])
}

// ===== Subforos profesionales (verificación por cuestionario) =====

/// Área profesional/de estudio (Informática, Psicología, Arquitectura, Química, etc.).
/// Un ForumCategory con `requiresFieldId` apuntando acá solo admite publicar a perfiles
/// con una ProfessionalVerification aprobada para ese field.
model ProfessionalField {
  id          Int      @id @default(autoincrement())
  slug        String   @unique  // ej: "informatica", "psicologia"
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  questions      ProfessionalFieldQuestion[]
  verifications  ProfessionalVerification[]
  categories     ForumCategory[]

  @@map("professional_fields")
}

/// Pregunta de opción múltiple para filtrar gente que dice ser de un área sin serlo
/// (ej. en informática, marcar "HTML" como lenguaje de programación revela que no lo es).
/// `correctOptionIndex` referencia `options` (array de strings, en el orden mostrado).
model ProfessionalFieldQuestion {
  id                 Int      @id @default(autoincrement())
  fieldId            Int
  field              ProfessionalField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  question           String   @db.VarChar(300)
  options            String[] // ej. ["HTML", "Python", "Ruby", "PHP"]
  correctOptionIndex Int
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())

  @@map("professional_field_questions")
  @@index([fieldId, isActive, sortOrder])
}

enum ProfessionalVerificationStatus {
  PASSED
  FAILED
}

/// Resultado de un intento de verificación por cuestionario. Se guardan las respuestas
/// dadas (no solo el resultado) para poder auditar/detectar patrones de bot; un perfil
/// puede reintentar (ver `assertCanAttemptVerification` — límite de intentos/tiempo).
model ProfessionalVerification {
  id           Int      @id @default(autoincrement())
  profileId    Int
  profile      ForumProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fieldId      Int
  field        ProfessionalField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  status       ProfessionalVerificationStatus
  score        Int      // cantidad de respuestas correctas
  totalQuestions Int
  answers      Json     // [{questionId, selectedOptionIndex}] — auditoría/anti-bot
  createdAt    DateTime @default(now())

  @@map("professional_verifications")
  @@index([profileId, fieldId, status])
}

// ===== Subforos por universidad (geolocalizados) =====

/// Universidad pública por departamento. `cityId` ancla el subforo a una ciudad del
/// catálogo (ForumCity) para la regla de visibilidad geolocalizada.
model University {
  id        Int      @id @default(autoincrement())
  name      String
  cityId    Int
  city      ForumCity @relation(fields: [cityId], references: [id], onDelete: Restrict)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  categories ForumCategory[]

  @@map("universities")
  @@index([cityId])
}

// ===== Motor genérico de comentarios con credibilidad =====
// Reusable por memes y torneo / QuemadosBolivia / Bolivia en Comunidad (fases
// posteriores) — `targetType`/`targetId` identifican el contenido comentado,
// igual patrón que ContentEvidence/TakedownRequest.

enum CommentVoteType {
  AGREE          // "de acuerdo"
  FAKE           // "está mamando" (falso)
  AI_GENERATED   // "creado con IA"
}

model GenericComment {
  id          Int      @id @default(autoincrement())
  targetType  String   // 'CONO_ENTRY' | 'FUNA' | 'COMUNIDAD_POST' | ...
  targetId    Int
  authorId    Int
  author      ForumProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body        String   @db.VarChar(500)

  agreeCount  Int      @default(0)
  fakeCount   Int      @default(0)
  aiCount     Int      @default(0)

  isHidden    Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())

  votes       GenericCommentVote[]

  @@map("generic_comments")
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([authorId])
}

/// Un solo voto por usuario por comentario (puede cambiar de tipo, no acumular varios).
model GenericCommentVote {
  id         Int      @id @default(autoincrement())
  commentId  Int
  comment    GenericComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  profileId  Int
  profile    ForumProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type       CommentVoteType
  createdAt  DateTime @default(now())

  @@map("generic_comment_votes")
  @@unique([commentId, profileId])
}


// ===== Geolocalización del foro (09-spec-geolocalizacion-foro.md) =====

model ForumCity {
  id          Int      @id @default(autoincrement())
  name        String              // ej. "La Paz"
  department  String              // ej. "La Paz" (departamento)
  latitude    Float
  longitude   Float
  radiusKm    Int      @default(30) // tamaño estimado (mayor ciudad del departamento)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  categories  ForumCityCategory[]
  profiles    ForumProfile[]
  universities University[]
  @@map("forum_cities")
  @@unique([name, department])
  @@index([department])
}

model ForumCityCategory {
  id         Int @id @default(autoincrement())
  cityId     Int
  city       ForumCity @relation(fields: [cityId], references: [id], onDelete: Cascade)
  categoryId Int
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@map("forum_city_categories")
  @@unique([cityId, categoryId])
}

model ForumRule {
  id          Int      @id @default(autoincrement())
  title       String
  body        String   @db.Text
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("forum_rules")
}

model ForumPost {
  id           Int      @id @default(autoincrement())
  authorId     Int?     // null si el autor fue eliminado
  author       ForumProfile? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categoryId   Int
  category     ForumCategory @relation(fields: [categoryId], references: [id])

  title        String   @db.VarChar(200)
  body         String   @db.Text
  images       String[] // array de URLs (Postgres native array)
  tags         String[] // array de tags/etiquetas

  city         String   // ciudad del post (copiada de ForumProfile.city al crear)
  type         ForumPostType @default(GENERAL)
  status       ForumPostStatus @default(OPEN)

  // Métricas (desnormalizadas para performance de feed)
  score        Float    @default(0)      // score ponderado para ranking
  upvotes      Int      @default(0)
  downvotes    Int      @default(0)
  replyCount   Int      @default(0)
  viewCount    Int      @default(0)

  // Moderación
  isHidden     Boolean  @default(false)  // auto-oculto por reportes
  isPinned     Boolean  @default(false)  // fijado por moderador
  deletedAt    DateTime?                 // eliminación lógica

  /// Detector de sesgo/incitación de Zona de Debate:
  /// heurístico 0-1). Null = no evaluado. Solo SUGIERE, nunca mueve solo —
  /// `debateSuggestedAt` no-null es lo que dispara el aviso al autor/moderador.
  debateFlagScore   Float?
  debateSuggestedAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  replies      ForumReply[]
  votes        ForumVote[]    @relation("PostVotes")
  reports      ForumReport[]  @relation("PostReports")

  @@map("forum_posts")
  @@index([categoryId, city, createdAt(sort: Desc)])
  @@index([city, score(sort: Desc), createdAt(sort: Desc)])
  @@index([status, replyCount])
  @@index([authorId])
  @@index([deletedAt])
  // Índice para búsqueda de texto (GIN en producción — aquí ILIKE suficiente para v1)
  @@index([city, createdAt(sort: Desc)])
}

enum ForumPostType {
  GENERAL
  PRECIO       // activa bot de precios
  EXISTENCIA   // activa bot de existencia
  EMPLEO
  ALQUILER
  ANTICROTICO
  DIRECCION
}

enum ForumPostStatus {
  OPEN
  RESOLVED     // tiene respuesta aceptada
  CLOSED       // cerrado por moderador
}

model ForumReply {
  id          Int      @id @default(autoincrement())
  postId      Int
  post        ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId    Int?      // null = bot o autor eliminado
  author      ForumProfile? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  body        String   @db.Text
  images      String[] // máx 2 imágenes

  // Flags especiales
  isBotReply  Boolean  @default(false)  // respuesta automática multitienda
  isAccepted  Boolean  @default(false)  // respuesta que resuelve la duda (marcada por autor del post)
  isHidden    Boolean  @default(false)
  deletedAt   DateTime?

  // Métricas
  upvotes     Int      @default(0)
  downvotes   Int      @default(0)
  score       Float    @default(0)

  /// Mismo detector que ForumPost (Zona de Debate) — corre sobre respuestas también,
  /// porque un hilo puede derivar en pelea de política en las respuestas sin que el post
  /// original lo sea. 
  debateFlagScore   Float?
  debateSuggestedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  votes       ForumVote[]   @relation("ReplyVotes")
  reports     ForumReport[] @relation("ReplyReports")

  @@map("forum_replies")
  @@index([postId, createdAt(sort: Asc)])
  @@index([postId, isAccepted])
  @@index([authorId])
}

model ForumVote {
  id          Int      @id @default(autoincrement())
  profileId   Int      // quién vota (ForumProfile)
  profile     ForumProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  targetType  ForumVoteTarget  // POST | REPLY
  postId      Int?
  post        ForumPost?  @relation("PostVotes",  fields: [postId],  references: [id], onDelete: Cascade)
  replyId     Int?
  reply       ForumReply? @relation("ReplyVotes", fields: [replyId], references: [id], onDelete: Cascade)

  value       Int      // +1 upvote | -1 downvote

  createdAt   DateTime @default(now())

  @@unique([profileId, targetType, postId])    // 1 voto por usuario por post
  @@unique([profileId, targetType, replyId])   // 1 voto por usuario por reply
  @@map("forum_votes")
  @@index([postId])
  @@index([replyId])
  @@index([profileId, createdAt(sort: Desc)])  // para límite diario y anti-brigada
}

enum ForumVoteTarget {
  POST
  REPLY
}

model ForumReputationComment {
  id         Int      @id @default(autoincrement())
  fromId     Int      // quien deja la reputación
  from       ForumProfile @relation("ReputationGiver",   fields: [fromId],   references: [id], onDelete: Cascade)
  toId       Int      // a quién se la deja
  to         ForumProfile @relation("ReputationReceiver", fields: [toId],     references: [id], onDelete: Cascade)

  value      Int      // +1 confiable | -1 no confiable
  comment    String?  @db.VarChar(300)

  createdAt  DateTime @default(now())

  @@unique([fromId, toId])  // solo 1 comentario de reputación por par de usuarios
  @@map("forum_reputation_comments")
  @@index([toId])
  @@index([fromId])
}

model ForumReport {
  id           Int      @id @default(autoincrement())
  reporterId   Int      // ForumProfile del que reporta
  reporter     ForumProfile @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)

  targetType   ForumReportTarget  // POST | REPLY | PROFILE
  postId       Int?
  post         ForumPost?   @relation("PostReports",  fields: [postId],  references: [id], onDelete: Cascade)
  replyId      Int?
  reply        ForumReply?  @relation("ReplyReports", fields: [replyId], references: [id], onDelete: Cascade)
  profileId    Int?         // si se reporta un perfil directamente

  reason       ForumReportReason
  detail       String?  @db.VarChar(500)
  status       ForumReportStatus @default(PENDING)
  resolvedBy   Int?     // userId del moderador/admin que resolvió
  resolvedAt   DateTime?
  resolution   String?  // nota del moderador

  createdAt    DateTime @default(now())

  @@map("forum_reports")
  @@index([status, createdAt(sort: Desc)])
  @@index([postId])
  @@index([replyId])
  @@index([reporterId])
}

enum ForumReportTarget {
  POST
  REPLY
  PROFILE
}

enum ForumReportReason {
  SPAM
  CONTENIDO_INAPROPIADO
  DESINFORMACION
  CONTENIDO_FALSO
  CONTENIDO_IA
  ESTAFA
  DATOS_PERSONALES
  PUBLICIDAD_ENCUBIERTA
  ES_UN_BOT
  ACOSO
  OTRO
}

enum ForumReportStatus {
  PENDING
  RESOLVED   // moderador aprobó → contenido eliminado
  REJECTED   // moderador rechazó → contenido restaurado
}

/// Marca idempotente de "post más votado del día ya premiado" — un `postId` solo puede
/// existir una vez acá aunque el job de `forum-daily.service.ts` corra dos veces (reintento,
/// réplica del proceso, etc.). El constraint único en `postId` es lo que hace la idempotencia
/// segura bajo concurrencia real, a diferencia de un simple "buscar si ya existe" en JS.
model ForumTopPostAward {
  id        Int      @id @default(autoincrement())
  postId    Int      @unique
  awardedAt DateTime @default(now())

  @@map("forum_top_post_awards")
}

model DailyActionCounter {
  id        Int      @id @default(autoincrement())
  userId    Int      // User.id (no ForumProfile.id, para consistencia)
  action    ForumDailyAction
  date      DateTime @db.Date   // solo la fecha (UTC-4 / Bolivia)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, action, date])
  @@map("daily_action_counters")
  @@index([userId, date])
}

enum ForumDailyAction {
  POST        // límite: 1/día
  REPLY       // límite: 5/día
  VOTE        // límite: 10/día (suma posts + replies + reputación)
}

model KarmaTransaction {
  id        Int      @id @default(autoincrement())
  profileId Int
  profile   ForumProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  amount    Int      // positivo = ganado, negativo = gastado/penalizado
  type      KarmaTransactionType
  refType   String?  // POST | REPLY | REDEEM | STREAK | CHALLENGE | RANK_BONUS
  refId     Int?     // id del post/reply que lo originó
  note      String?  // nota manual del admin o descripción automática

  createdAt DateTime @default(now())

  @@map("karma_transactions")
  @@index([profileId, createdAt(sort: Desc)])
  @@index([type])
}

enum KarmaTransactionType {
  EARN_UPVOTE       // recibí upvote en post o reply (+1)
  EARN_BEST_ANSWER  // mi respuesta fue aceptada (+10)
  EARN_TOP_POST     // post más votado del día (+5)
  EARN_STREAK       // bonus por racha de días consecutivos
  EARN_CHALLENGE    // desafío diario completado (+2)
  EARN_FIRST_POST   // primer post del día (+1)
  EARN_ADMIN        // ajuste manual del admin
  DEDUCT_DOWNVOTE   // recibí downvote (-1, piso 0)
  DEDUCT_REPORT     // post/reply penalizado por moderador (-5)
  REDEEM            // karma canjeado por monedas (-N, karma histórico intacto)
}

// ===== RBAC (core de administración dinámico, 01-spec-core-rbac.md) =====

model RbacRole {
  id          Int      @id @default(autoincrement())
  code        String   @unique          // 'ADMIN','SELLER','SUPPORT','ANALYST',...
  name        String                    // 'Administrador global','Soporte',...
  description String?
  isSystem    Boolean  @default(false)  // true = los 4 de fábrica (no se borran)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  permissions RolePermission[]
  menus       RoleMenu[]
  users       UserRole[]
  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  code        String   @unique          // 'products.create','users.manage','forum.moderate',...
  name        String                    // 'Crear productos',...
  module      String   @default("core") // 'core','forum','seller','admin'
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  roles       RolePermission[]
  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         RbacRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Menu {
  id        Int      @id @default(autoincrement())
  code      String   @unique          // 'admin.dashboard','seller.products','admin.users',...
  label     String                    // 'Dashboard','Productos',...
  path      String                    // '/admin','/seller/productos',...
  icon      String?                   // nombre de icono MUI / emoji móvil
  parentId  Int?                      // menús anidados
  parent    Menu?    @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Menu[]   @relation("MenuTree")
  module    String   @default("core")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  roles     RoleMenu[]
  @@map("menus")
}

model RoleMenu {
  roleId Int
  menuId Int
  role   RbacRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu   Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  @@id([roleId, menuId])
  @@map("role_menus")
}

model UserRole {
  userId Int
  roleId Int
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   RbacRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ============================================================================
// Moderación reforzada: memes y torneo / QuemadosBolivia / Bolivia en
// Comunidad.
//
// Estos modelos son GENÉRICOS a propósito: las tablas de contenido de cada
// sección (funas, entradas del torneo, publicaciones de Comunidad) todavía no
// existen — son trabajo posterior. `targetType` +
// `targetId` identifican el contenido al que se refiere cada fila sin
// necesidad de una FK a una tabla que aún no existe; cuando esas tablas se
// creen, targetType deberá usar sus nombres (ej. 'FUNA', 'CONO_ENTRY',
// 'COMUNIDAD_POST', 'TAKEDOWN_REQUEST').
// ============================================================================

enum EvidencePurpose {
  SUPPORT   // evidencia que respalda la publicación original (obligatoria para publicar)
  TAKEDOWN  // evidencia adjunta a una solicitud de baja
}

enum EvidenceFileType {
  PHOTO
  SCREENSHOT
  DOCUMENT
  OTHER
}

/// Archivo adjunto obligatorio para publicaciones de las secciones reforzadas.
/// Ver Reglamento §2.1-§2.2 y §5 (metadatos de captura, campo `capturedInApp`).
model ContentEvidence {
  id             Int              @id @default(autoincrement())
  targetType     String           // 'FUNA' | 'CONO_ENTRY' | 'COMUNIDAD_POST' | 'TAKEDOWN_REQUEST'
  targetId       Int
  purpose        EvidencePurpose
  uploadedByUserId Int?           // null si lo sube alguien sin cuenta a través de un TakedownRequest
  uploadedBy     User?            @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  fileUrl        String
  fileType       EvidenceFileType
  description    String?          @db.VarChar(500)
  /// true si se capturó desde la cámara dentro de la app (no galería/descarga) — señal de
  /// riesgo adicional para el moderador, no prueba absoluta. Null = desconocido (subida web).
  capturedInApp  Boolean?
  capturedAt     DateTime?        // timestamp del dispositivo al momento de la captura, si se conoce
  createdAt      DateTime         @default(now())

  @@map("content_evidence")
  @@index([targetType, targetId])
  @@index([uploadedByUserId])
}

enum TakedownStatus {
  PENDING_VERIFICATION // esperando que el solicitante confirme su correo
  PENDING_REVIEW        // correo verificado, en cola de revisión de moderación
  APPROVED               // se aprobó la baja — el contenido se oculta
  REJECTED                // se rechazó — el contenido se mantiene
}

/// Solicitud de baja de una publicación. Quien solicita puede NO tener cuenta en la
/// plataforma (por eso los datos de contacto van en la propia solicitud, no se
/// asumen de un User), pero sí debe verificar su correo antes de que la solicitud
/// pase a revisión. Ver Reglamento §3.
model TakedownRequest {
  id                   Int             @id @default(autoincrement())
  targetType           String          // 'FUNA' | 'CONO_ENTRY' | 'COMUNIDAD_POST'
  targetId             Int

  requesterName        String
  requesterPhone       String
  requesterEmail       String
  emailVerified        Boolean         @default(false)
  emailVerifyCode      String?         // hash del código, no el código en texto plano
  emailVerifyExpiresAt DateTime?
  emailVerifyAttempts  Int             @default(0)

  reason               String          @db.Text
  status               TakedownStatus  @default(PENDING_VERIFICATION)

  resolvedByUserId     Int?
  resolvedBy           User?           @relation("TakedownResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedAt           DateTime?
  resolution           String?         @db.Text

  createdAt            DateTime        @default(now())
  updatedAt             DateTime       @updatedAt

  @@map("takedown_requests")
  @@index([targetType, targetId])
  @@index([status, createdAt(sort: Desc)])
}

enum StrikeSeverity {
  WARNING   // sin restricción de cuenta, solo queda registrada
  MINOR     // pierde el privilegio de publicar en estas secciones 30 días
  MAJOR     // baneo de estas secciones + entrada en lista negra
  BAN       // baneo total de la cuenta
}

/// Falta registrada contra un usuario en el contexto de estas secciones reforzadas.
/// Ver Reglamento §4 (tabla de sanciones). El historial completo (no solo el conteo)
/// se mantiene siempre, incluso tras vencer una suspensión — es lo que sostiene la
/// "acumulación" de faltas graves.
model UserStrike {
  id          Int             @id @default(autoincrement())
  userId      Int
  user        User            @relation("UserStrikeSubject", fields: [userId], references: [id], onDelete: Cascade)

  severity    StrikeSeverity
  reason      String          @db.Text
  relatedType String?         // 'FUNA' | 'CONO_ENTRY' | 'COMUNIDAD_POST' | 'TAKEDOWN_REQUEST'
  relatedId   Int?

  issuedByUserId Int?         // null = automático (ej. umbral de reportes), si no, moderador/admin
  issuedBy    User?           @relation("StrikeIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  /// Fecha en que vence una suspensión MINOR/MAJOR; null para WARNING/BAN (no vencen).
  suspendedUntil DateTime?

  createdAt   DateTime        @default(now())

  @@map("user_strikes")
  @@index([userId, createdAt(sort: Desc)])
  @@index([severity])
}

enum BlacklistEntryType {
  USER
  EMAIL
  PHONE
  PRODUCT
  DEVICE_FINGERPRINT
}

/// Lista negra independiente del `userId`: banear una cuenta no alcanza si el mismo
/// teléfono/correo puede simplemente crear otra — por eso EMAIL/PHONE/PRODUCT son
/// entradas propias, no solo un flag en User. Ver Reglamento §4/§8.
model BlacklistEntry {
  id            Int                @id @default(autoincrement())
  type          BlacklistEntryType
  value         String             // el email, teléfono, productId (como string) o userId (como string)
  reason        String             @db.Text
  addedByUserId Int
  addedBy       User               @relation("BlacklistAdder", fields: [addedByUserId], references: [id], onDelete: Restrict)
  isActive      Boolean            @default(true)
  expiresAt     DateTime?          // null = permanente
  createdAt     DateTime           @default(now())

  @@map("blacklist_entries")
  @@unique([type, value])
  @@index([type, isActive])
}

// ============================================================================
// memes y torneo (foro). Dos modalidades:
// - MEME: ranking libre estilo cuantarazon.com (subís, la comunidad vota positivo/nica).
// - TOURNAMENT: cuadro de eliminatorias tipo VS, votación diaria (peor banco, peor
//   político, etc.), creado por un usuario con verificación profesional aprobada.
// Reusa ContentEvidence (targetType='CONO_ENTRY', evidencia obligatoria por entrada) y
// GenericComment (targetType='CONO_ENTRY', info/discusión sobre cada entrada) — ver
// reglamento del foro.
// ============================================================================

enum ConoThemeType {
  MEME
  TOURNAMENT
}

model ConoTheme {
  id            Int           @id @default(autoincrement())
  slug          String        @unique
  title         String
  description   String?       @db.Text
  type          ConoThemeType

  createdById   Int
  createdBy     ForumProfile  @relation("ConoThemeCreator", fields: [createdById], references: [id], onDelete: Cascade)

  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())

  entries       ConoEntry[]
  matches       ConoMatch[]

  @@map("cono_themes")
  @@index([type, isActive])
}

model ConoEntry {
  id              Int       @id @default(autoincrement())
  themeId         Int
  theme           ConoTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  submittedById   Int
  submittedBy     ForumProfile @relation("ConoEntrySubmitter", fields: [submittedById], references: [id], onDelete: Cascade)

  label           String    @db.VarChar(120)
  imageUrl        String

  positiveCount   Int       @default(0)
  negativeCount   Int       @default(0) // "nica"

  isHidden        Boolean   @default(false) // moderación (evidencia insuficiente/denunciada)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())

  votes           ConoVote[]
  matchesAsA      ConoMatch[] @relation("MatchEntryA")
  matchesAsB      ConoMatch[] @relation("MatchEntryB")
  wonMatches      ConoMatch[] @relation("MatchWinner")

  @@map("cono_entries")
  @@index([themeId, deletedAt, isHidden])
  @@index([submittedById])
}

enum ConoVoteValue {
  POSITIVE
  NEGATIVE
}

/// Voto directo sobre una entrada (modalidad MEME — ranking estilo cuantarazon).
model ConoVote {
  id        Int           @id @default(autoincrement())
  entryId   Int
  entry     ConoEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  profileId Int
  profile   ForumProfile  @relation("ConoVoter", fields: [profileId], references: [id], onDelete: Cascade)
  value     ConoVoteValue
  createdAt DateTime      @default(now())

  @@map("cono_votes")
  @@unique([entryId, profileId])
  @@index([entryId, createdAt])
}

enum ConoMatchStatus {
  PENDING   // esperando el día de votación
  ACTIVE    // votación abierta hoy
  RESOLVED  // ya tiene ganador
}

/// Enfrentamiento 1 vs 1 (modalidad TOURNAMENT) — votación diaria, arriba la foto+nombre
/// de cada competidor, abajo sus comentarios (GenericComment) con info que "ilumina" el voto.
model ConoMatch {
  id          Int             @id @default(autoincrement())
  themeId     Int
  theme       ConoTheme       @relation(fields: [themeId], references: [id], onDelete: Cascade)
  round       Int             @default(1)

  entryAId    Int
  entryA      ConoEntry       @relation("MatchEntryA", fields: [entryAId], references: [id])
  entryBId    Int
  entryB      ConoEntry       @relation("MatchEntryB", fields: [entryBId], references: [id])

  votesA      Int             @default(0)
  votesB      Int             @default(0)
  status      ConoMatchStatus @default(PENDING)

  winnerId    Int?
  winner      ConoEntry?      @relation("MatchWinner", fields: [winnerId], references: [id])

  votingDate  DateTime        @db.Date // día boliviano en que se vota este match
  createdAt   DateTime        @default(now())

  matchVotes  ConoMatchVote[]

  @@map("cono_matches")
  @@index([themeId, round])
  @@index([status, votingDate])
}

model ConoMatchVote {
  id        Int       @id @default(autoincrement())
  matchId   Int
  match     ConoMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  profileId Int
  profile   ForumProfile @relation("ConoMatchVoter", fields: [profileId], references: [id], onDelete: Cascade)
  choice    String    // 'A' | 'B'
  createdAt DateTime  @default(now())

  @@map("cono_match_votes")
  @@unique([matchId, profileId])
}

// ============================================================================
// Zona de Debate. Subforo marcado con
// ForumCategory.isDebateZone=true — publicar/responder ahí muestra un alias
// (DebateZoneAlias, estable por usuario) en vez del forumUsername real. La
// plataforma sigue sabiendo la autoría real (moderación normal aplica).
// ============================================================================

/// Alias estable por usuario dentro de Zona de Debate:
/// decisión: estable, no rotativo por publicación). Se genera la primera vez que el usuario
/// publica o responde en la categoría con isDebateZone=true.
model DebateZoneAlias {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alias     String   @unique
  createdAt DateTime @default(now())

  @@map("debate_zone_aliases")
}

// ============================================================================
// Chat para Bots. Cuentas de bot DECLARADAS
// (Lectura B — nunca se hacen pasar por humanas), que conversan con usuarios
// reales para "comprenderlos mejor" y (fase posterior) debaten en Zona de
// Debate. Solo bots operados por el equipo de LaCase en esta primera fase.
// ============================================================================

enum BotAccountStatus {
  ACTIVE
  SUSPENDED // no puede iniciar conversaciones/debates nuevos
  BANNED    // cuenta + dispositivo + teléfono en BlacklistEntry (ver UserStrike relatedType='BOT_ACCOUNT')
}

/// Declara que un User existente es un bot — reusa la infraestructura de cuentas (auth, etc.)
/// en vez de duplicarla. Un bot NO es un Role (ver enum Role: ADMIN/SELLER/CUSTOMER,
/// sin BOT) — es un tipo de cuenta ortogonal, mismo patrón que ForumProfile.
model BotAccount {
  id               Int               @id @default(autoincrement())
  userId           Int               @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName      String            // nombre público del bot, ej. "Bot Economía Liberal"
  declaredStance   String            @db.Text // postura/propósito declarado, visible al usuario
  status           BotAccountStatus  @default(ACTIVE)

  operatedByUserId Int               // usuario del equipo LaCase responsable
  operatedBy       User              @relation("BotOperator", fields: [operatedByUserId], references: [id], onDelete: Restrict)

  timeBudgetMsDefault Int            @default(600000) // 10 min por defecto, presupuesto total por debate (§3)
  charLimitPerTurn    Int            @default(700)    // tope de caracteres por turno

  createdAt        DateTime          @default(now())
  updatedAt         DateTime         @updatedAt

  conversations     BotConversation[]

  @@map("bot_accounts")
  @@index([status])
}

enum BotMessageSender {
  BOT
  USER
}

/// Chat bot↔usuario. Se guarda un resumen (no la transcripción cruda indefinidamente) —
/// Ver reglamento del foro: personalización, contexto de moderación solo con
/// reporte activo, o analítica agregada. `rawExpiresAt` marca cuándo un job de purga borra los
/// BotConversationMessage crudos (propuesta: 30 días), dejando solo el `summary`.
model BotConversation {
  id               Int       @id @default(autoincrement())
  botAccountId     Int
  botAccount       BotAccount @relation(fields: [botAccountId], references: [id], onDelete: Cascade)
  userId           Int
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  summary          String?   @db.Text
  rawExpiresAt     DateTime

  startedAt        DateTime  @default(now())
  endedAt          DateTime?

  messages         BotConversationMessage[]

  @@map("bot_conversations")
  @@index([botAccountId])
  @@index([userId])
  @@index([rawExpiresAt])
}

model BotConversationMessage {
  id             Int              @id @default(autoincrement())
  conversationId Int
  conversation   BotConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         BotMessageSender
  body           String           @db.Text
  createdAt      DateTime         @default(now())

  @@map("bot_conversation_messages")
  @@index([conversationId, createdAt])
}

// ═══ Empleos: ofertas de trabajo publicadas por tiendas verificadas, moderadas por el admin ═══

enum JobPayPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum JobStatus {
  PENDING
  APPROVED
  REJECTED
  CLOSED
}

model JobCategory {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  slug      String       @unique
  icon      String?
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  postings  JobPosting[]

  @@map("job_categories")
}

model JobPosting {
  applications    JobApplication[]
  id              Int          @id @default(autoincrement())
  storeId         Int
  store           User         @relation("JobPostingsStore", fields: [storeId], references: [id])
  createdById     Int
  createdBy       User         @relation("JobPostingsCreated", fields: [createdById], references: [id])
  categoryId      Int
  category        JobCategory  @relation(fields: [categoryId], references: [id])
  title           String
  description     String       @db.Text
  requirements    String?      @db.Text
  city            String
  locationState   String?
  latitude        Float?
  longitude       Float?
  payPeriod       JobPayPeriod
  salaryMin       Decimal?     @db.Decimal(12, 2)
  salaryMax       Decimal?     @db.Decimal(12, 2)
  vacancies       Int          @default(1)
  schedule        String?
  contactPhone    String?
  status          JobStatus    @default(PENDING)
  rejectionReason String?
  reviewedById    Int?
  reviewedBy      User?        @relation("JobPostingsReviewed", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  publishedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status, expiresAt])
  @@index([storeId])
  @@index([categoryId])
  @@map("job_postings")
}

enum JobApplicationStatus {
  RECEIVED
  VIEWED
  SHORTLISTED
  REJECTED
  HIRED
  WITHDRAWN
}

model JobApplication {
  id             Int                  @id @default(autoincrement())
  jobId          Int
  job            JobPosting           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId    Int
  applicant      User                 @relation("JobApplications", fields: [applicantId], references: [id], onDelete: Cascade)
  message        String               @db.Text
  contactPhone   String
  expectedSalary Decimal?             @db.Decimal(12, 2)
  resumeUrl      String?
  cvFile         String?
  cvName         String?
  status         JobApplicationStatus @default(RECEIVED)
  storeNote      String?
  reviewedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([jobId, applicantId])
  @@index([applicantId])
  @@index([jobId, status])
  @@map("job_applications")
}
