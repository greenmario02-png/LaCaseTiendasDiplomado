# URL del backend (API REST). En desarrollo local puede dejarse vacío: Vite hace proxy a :3000.
# Para apuntar a otro backend: VITE_API_URL=http://localhost:3000/api
VITE_API_URL=http://localhost:3000/api

# Opcional: URL base para Socket.IO. Por defecto se deriva del origen de VITE_API_URL.
# VITE_SOCKET_URL=http://localhost:3000
