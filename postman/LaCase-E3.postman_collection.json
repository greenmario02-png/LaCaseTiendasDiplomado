                  "const j = (()=>{ try { return pm.response.json(); } catch(e) { return {}; } })();",
                  "const __m = {",
                  "\"Categorías (elige una hoja)\": () => {\npm.test('HTTP 200', () => pm.response.to.have.status(200));\nconst hojas = (n) => n.flatMap((x) => (x.children && x.children.length ? hojas(x.children) : [x]));\nconst bar = j.data.filter((c) => c.slug === 'bar-y-bebidas'); pm.collectionVariables.set('categoryId', hojas(bar.length ? bar : j.data)[0].id);\n},",
                  "\"CP-22 · Vendedor publica un producto 201\": () => {\npm.test('HTTP 201', () => pm.response.to.have.status(201));\npm.collectionVariables.set('productA', j.data.id);\n},",
                  "\"CP-23 · Producto inválido 400\": () => {\npm.test('HTTP 400', () => pm.response.to.have.status(400));\npm.test('Formato de error único: error.code = BAD_REQUEST', () => pm.expect(j.error.code).to.eql('BAD_REQUEST'));\n},",
