                  "\"CP-28 · Aprobado aparece en el catálogo\": () => {\npm.test('HTTP 200', () => pm.response.to.have.status(200));\npm.test('El producto aparece', () => pm.expect(j.data.map((p) => p.id)).to.include(Number(pm.collectionVariables.get('productA'))));\n},",
