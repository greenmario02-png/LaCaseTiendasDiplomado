                  "\"CP-25 · Sin aprobar no se lista\": () => {\npm.test('HTTP 200', () => pm.response.to.have.status(200));\npm.test('El producto nuevo NO aparece', () => pm.expect(j.data.map((p) => p.id)).to.not.include(Number(pm.collectionVariables.get('productA'))));\n},",
