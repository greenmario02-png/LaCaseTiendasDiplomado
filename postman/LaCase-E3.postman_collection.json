          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = (()=>{ try { return pm.response.json(); } catch(e) { return {}; } })();",
                  "const __m = {",
                  "\"CP-11 · Login válido (vendedor)\": () => {\npm.test('CP-11 · Login válido (vendedor): HTTP 200', () => pm.response.to.have.status(200));\npm.test('El token vence en 900 s (15 min)', () => { const p = JSON.parse(atob(j.data.accessToken.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))); pm.expect(p.exp - p.iat).to.eql(900); });\npm.test('La respuesta no expone passwordHash', () => pm.expect(JSON.stringify(j)).to.not.match(/passwordHash/));\npm.collectionVariables.set('sellerToken', j.data.accessToken);\n},",
                  "\"Login válido (comprador)\": () => {\npm.test('Login válido (comprador): HTTP 200', () => pm.response.to.have.status(200));\npm.test('El token vence en 900 s (15 min)', () => { const p = JSON.parse(atob(j.data.accessToken.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))); pm.expect(p.exp - p.iat).to.eql(900); });\npm.test('La respuesta no expone passwordHash', () => pm.expect(JSON.stringify(j)).to.not.match(/passwordHash/));\npm.collectionVariables.set('buyerToken', j.data.accessToken);\n},",
                  "\"Login válido (administrador, solo web)\": () => {\npm.test('Login válido (administrador, solo web): HTTP 200', () => pm.response.to.have.status(200));\npm.test('El token vence en 900 s (15 min)', () => { const p = JSON.parse(atob(j.data.accessToken.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))); pm.expect(p.exp - p.iat).to.eql(900); });\npm.test('La respuesta no expone passwordHash', () => pm.expect(JSON.stringify(j)).to.not.match(/passwordHash/));\npm.collectionVariables.set('adminToken', j.data.accessToken);\n},",
                  "\"CP-12 · Login inválido 401\": () => {\npm.test('HTTP 401', () => pm.response.to.have.status(401));\npm.test('Formato de error único: error.code = UNAUTHORIZED', () => pm.expect(j.error.code).to.eql('UNAUTHORIZED'));\n},",
                  "\"CP-13 · Ruta protegida sin token 401\": () => {\npm.test('HTTP 401', () => pm.response.to.have.status(401));\npm.test('Formato de error único: error.code = UNAUTHORIZED', () => pm.expect(j.error.code).to.eql('UNAUTHORIZED'));\n},",
                  "\"CP-15 · Comprador en ruta de vendedor 403\": () => {\npm.test('HTTP 403', () => pm.response.to.have.status(403));\npm.test('Formato de error único: error.code = FORBIDDEN', () => pm.expect(j.error.code).to.eql('FORBIDDEN'));\n},",
                  "\"CP-18 · Registro inválido 400\": () => {\npm.test('HTTP 400', () => pm.response.to.have.status(400));\npm.test('Formato de error único: error.code = BAD_REQUEST', () => pm.expect(j.error.code).to.eql('BAD_REQUEST'));\npm.test('Detalle por campo', () => pm.expect(j.error.details).to.be.an('array').that.is.not.empty);\n},",
                  "\"CP-21 · Admin desde la app móvil 403\": () => {\npm.test('HTTP 403', () => pm.response.to.have.status(403));\npm.test('Formato de error único: error.code = FORBIDDEN', () => pm.expect(j.error.code).to.eql('FORBIDDEN'));\n},",
                  "};",
